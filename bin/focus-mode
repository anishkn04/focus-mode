#!/usr/bin/env bash
# Focus Mode CLI for Hyprland.
# Usage:
#   focus-mode start [--preset NAME] [--duration 25m] [--allow kitty,code] [--topic "text"]
#   focus-mode stop            # quiz coming; currently just unlocks
#   focus-mode unlock
#   focus-mode status
#   focus-mode pick            # interactive fuzzel flow
set -u

CONFIG_DIR="$HOME/.config/focus-mode"
PRESETS_DIR="$CONFIG_DIR/presets"
STATE_FILE="$CONFIG_DIR/state.json"
PID_FILE="$CONFIG_DIR/enforcer.pid"
ENFORCER="$HOME/.config/hypr/scripts/focus-enforcer.py"
PICKER="$HOME/.config/hypr/scripts/focus-pick.sh"

is_active() {
  [ -f "$STATE_FILE" ] && python3 -c "import json,sys; sys.exit(0 if json.load(open('$STATE_FILE')).get('active') else 1)" 2>/dev/null
}

# Parse "25", "25m", "1h", "1h30m" -> seconds
parse_duration() {
  local input="${1:-25m}" total=0 num suffix
  local rest="$input"
  if [[ "$rest" =~ ^[0-9]+$ ]]; then echo $((rest * 60)); return 0; fi
  while [[ "$rest" =~ ^([0-9]+)([smh])(.*)$ ]]; do
    num="${BASH_REMATCH[1]}"; suffix="${BASH_REMATCH[2]}"; rest="${BASH_REMATCH[3]}"
    case "$suffix" in
      s) total=$((total + num)) ;;
      m) total=$((total + num * 60)) ;;
      h) total=$((total + num * 3600)) ;;
    esac
  done
  if [[ -z "$rest" && "$total" -gt 0 ]]; then echo "$total"; return 0; fi
  echo "invalid duration: $1 (examples: 25, 25m, 1h, 1h30m)" >&2
  return 1
}

cmd_start() {
  local preset="" duration="25m" allow_extra="" topic="" title_block_extra=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --preset) preset="${2:-}"; shift 2 ;;
      --duration) duration="${2:-}"; shift 2 ;;
      --allow) allow_extra="${2:-}"; shift 2 ;;
      --topic) topic="${2:-}"; shift 2 ;;
      --title-block) title_block_extra="${2:-}"; shift 2 ;;
      *) echo "unknown flag: $1" >&2; return 1 ;;
    esac
  done

  if is_active; then echo "Focus Mode already active." >&2; return 1; fi

  local secs now ends allowed_json grandfathered_json
  secs="$(parse_duration "$duration")" || return 1
  now="$(date +%s)"
  ends=$((now + secs))

  local preset_classes=""
  if [ -n "$preset" ]; then
    local pf="$PRESETS_DIR/$preset.json"
    [ -f "$pf" ] || { echo "preset not found: $preset" >&2; return 1; }
    preset_classes="$(jq -r '.classes[]' "$pf" 2>/dev/null | tr ',' ' ')"
    preset_title_block="$(jq -c '.title_block // []' "$pf" 2>/dev/null)"
    [ -n "$preset_title_block" ] || preset_title_block="[]"
  fi
  allowed_json="$(printf '%s\n%s' "$preset_classes" "$(echo "$allow_extra" | tr ',' ' ')" \
    | tr ' ' '\n' | sed 's/,/ /g' | tr ' ' '\n' | grep -v '^$' | tr '[:upper:]' '[:lower:]' | sort -u | jq -R . | jq -s -c .)"
  [ "$allowed_json" != "[]" ] || { echo "allowlist is empty. Use --preset or --allow." >&2; return 1; }
  extra_title_json="$(printf '%s' "$title_block_extra" | tr ',' '\n' | grep -v '^$' \
    | jq -R '{pattern: ., label: .}' | jq -s -c . 2>/dev/null)"
  [ -n "$extra_title_json" ] || extra_title_json="[]"
  title_block_json="$(printf '%s\n%s' "$preset_title_block" "$extra_title_json" | jq -s -c 'add' 2>/dev/null)"
  [ -n "$title_block_json" ] || title_block_json="[]"

  # Snapshot windows already open -> grandfathered (left alone).
  # Stored as {address: {pid, class}}: Hyprland recycles addresses, so a bare
  # address would let a NEW window inherit a dead window's exemption.
  grandfathered_json="$(hyprctl clients -j 2>/dev/null | jq -c 'map({key: .address, value: {pid: .pid, class: .class}}) | from_entries')"
  [ -n "$grandfathered_json" ] || grandfathered_json="{}"
  mkdir -p "$CONFIG_DIR"

  python3 - "$STATE_FILE" <<EOF
import json
state = {
    "active": True,
    "allowed": $allowed_json,
    "title_block": $title_block_json,
    "grandfathered": $grandfathered_json,
    "duration_secs": 0,
    "started_at": 0,
    "ends_at": 0,
}
json.dump(state, open(state_file, "w"), indent=2)
EOF

  if [ -f "$PID_FILE" ] && kill -0 "$(cat "$PID_FILE")" 2>/dev/null; then
    kill "$(cat "$PID_FILE")" 2>/dev/null || true
    sleep 0.5
  fi
  setsid python3 "$ENFORCER" >/dev/null 2>&1 < /dev/null &

  local n
  n="$(echo "$allowed_json" | jq -r 'join(", ")')"
  echo "Session started: $duration. Allowed: $n."
}

cmd_unlock() {
  if ! is_active; then echo "Focus Mode is not active." >&2; return 1; fi
  python3 -c "
import json
p = '$STATE_FILE'
s = json.load(open(p))
s['active'] = False
json.dump(s, open(p, 'w'), indent=2)
"
  if [ -f "$PID_FILE" ]; then
    kill "$(cat "$PID_FILE")" 2>/dev/null || true
    rm -f "$PID_FILE"
  fi
  pkill -f "focus-enforcer.py" 2>/dev/null || true
  prev="$(python3 -c "import json; print(json.load(open('$STATE_FILE')).get('dnd_prev','off'))" 2>/dev/null)"
  if [ "$prev" = "off" ]; then noctalia msg notification-dnd-set false >/dev/null 2>&1 || true; fi
  noctalia msg caffeine-disable >/dev/null 2>&1 || true
  echo "Focus Mode ended."
}

cmd_status() {
  if ! is_active; then echo "Focus Mode: inactive"; return 0; fi
  python3 - "$STATE_FILE" <<'EOF'
import json, sys, time
s = json.load(open(sys.argv[1]))
now = time.time()
rem = max(0, int(s.get("ends_at", now) - now))
h, m = rem // 3600, (rem % 3600) // 60
print(f"Focus Mode: ACTIVE  remaining {h}h {m:02d}m")
print(f"Allowed: {', '.join(s.get('allowed', []))}")
EOF
}

cmd_stop() {
  if ! is_active; then echo "Focus Mode is not active." >&2; return 1; fi
  python3 -c "
import json
p = '$STATE_FILE'
s = json.load(open(p))
s['quiz_active'] = True
json.dump(s, open(p, 'w'), indent=2)
"
  if command -v kitty >/dev/null 2>&1; then
    kitty --title "Focus Quiz - answer to unlock" "$HOME/.config/hypr/scripts/focus-quiz-term.sh" &
    echo "Exit quiz opened in a new terminal. Answer it to unlock."
  else
    python3 "$HOME/.config/hypr/scripts/focus-quiz.py"
  fi
}

cmd_cancel() {
  if ! is_active; then echo "Focus Mode is not active." >&2; return 1; fi
  echo "Cancelling still takes work: answer 3 questions, then confirm."
  if ! python3 "$HOME/.config/hypr/scripts/focus-quiz.py" --self-review-cancel; then
    echo "Cancel aborted." >&2; return 1
  fi
  python3 -c "
import json, time
p = '$STATE_FILE'
s = json.load(open(p))
s['cancelled'] = True
s['cancelled_at'] = time.time()
json.dump(s, open(p, 'w'), indent=2)
"
  cmd_unlock
}

cmd_gui() {
  [ -x "$CONFIG_DIR/gui/.venv/bin/python" ] || { echo "GUI venv missing" >&2; return 1; }
  setsid "$CONFIG_DIR/gui/.venv/bin/python" "$CONFIG_DIR/gui/app.py" "$@" >/dev/null 2>&1 < /dev/null &
  echo "Focus Mode GUI launched."
}

cmd_sites() {
  python3 - <<'EOF'
import json, os
p = os.path.expanduser("~/.config/focus-mode/site-allowlist.json")
try:
    rules = json.load(open(p))
except Exception as e:
    print(f"no site policy: {e}"); raise SystemExit(1)
print(f"Browsers watched: {', '.join(rules.get('browsers', []))}")
print(f"Warn-then-kill grace: {rules.get('grace_secs', 30)}s")
print("Precedence: block wins over allow; allow wins over default-deny.")
print("Blocked apps & windows (every preset, instant kill):")
ablock = rules.get('app_block', [])
if ablock:
    for e in ablock:
        if e.get('kind') == 'app':
            print(f"  - app: {e.get('class', '')}  ({e.get('label', '')})")
        else:
            print(f"  - title: {e.get('pattern', '')}  ({e.get('label', '')})")
else:
    print("  (none)")
print("Blocked page-title patterns (win over allow):")
blocked = rules.get('block', [])
if blocked:
    for e in blocked:
        print(f"  - {e.get('pattern', '')}  ({e.get('label', '')})")
else:
    print("  (none)")
print("Allowed page-title patterns:")
for e in rules.get("allow", []):
    print(f"  - {e.get('pattern', '')}  ({e.get('label', '')})")
print(f"\nEdit: {p} (live, no restart needed)")
EOF
}

cmd_help() {
  case "${1:-}" in
    ""|help)
      cat <<'HELPEOF'
Focus Mode — Zen-style focus sessions for Hyprland.

Usage: focus-mode [COMMAND] [OPTIONS]

Commands:
  start     Begin a session [--preset/--duration/--allow/--topic]  [s]
  stop      Open the exit quiz (the normal way out)                [q]
  status    Show the active session                                [st]
  cancel    Bail out: 3 questions + typed confirm                  [c]
  pick      Interactive fuzzel starter                             [p]
  gui       Open the Qt dashboard                                  [g]
  sites     Show the browser site allowlist                        [w]
  unlock    End the session (called by the quiz on pass)           [u]
  help      This message or a command's help                       [h]

Examples:
  focus-mode pick
  focus-mode start --preset study --duration 25m --topic "thermo"
  focus-mode s --duration 1h --allow kitty,code
Run 'focus-mode help COMMAND' for command-specific options.
HELPEOF
      return 0 ;;
    s|start)
      echo "Usage: focus-mode start [--preset NAME] [--duration DUR] [--allow A,B] [--topic TEXT] [--title-block P1,P2]"; return 0 ;;
    *)
      echo "unknown help topic: $1 (see 'focus-mode help')" >&2; return 1 ;;
  esac
}

# Per-command help: `focus-mode start -h` == `focus-mode help start`.
if [ "${2:-}" = "-h" ] || [ "${2:-}" = "--help" ]; then
  case "${1:-}" in
    s|start) set -- help start ;; q|stop) set -- help stop ;;
    st|status) set -- help status ;; c|cancel) set -- help cancel ;;
    p|pick) set -- help pick ;; g|gui) set -- help gui ;;
    w|sites) set -- help sites ;; u|unlock) set -- help unlock ;;
    h|help) set -- help help ;; *) set -- help "$1" ;;
  esac
fi

case "${1:-}" in
  start|s) shift; cmd_start "$@" ;;
  stop|q) cmd_stop ;;
  cancel|c) cmd_cancel ;;
  unlock|u) cmd_unlock ;;
  status|st) cmd_status ;;
  pick|p) exec "$PICKER" ;;
  gui|g) shift; cmd_gui "$@" ;;
  sites|w) cmd_sites ;;
  help|h|-h|--help) cmd_help "${2:-}" ;;
  "") echo "usage: focus-mode [COMMAND] [OPTIONS]" >&2
      echo "Try 'focus-mode help' for more information." >&2; exit 1 ;;
  *) echo "focus-mode: unknown command: $1" >&2; exit 1 ;;
esac
